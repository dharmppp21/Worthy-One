# SignalForge Backend Configuration
# Copy this file to .env and fill in your values

# PostgreSQL connection (used when database persistence is enabled)
DATABASE_URL=postgresql+psycopg2://signforge:signforge@localhost:5432/signforge

# Redis connection (used for rolling windows and hot operational state)
REDIS_URL=redis://localhost:6379/0

# Kafka / Redpanda brokers (event-driven telemetry ingestion)
KAFKA_BROKERS=localhost:9092

# Application settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# Ingestion safety
# Reject request bodies larger than this many bytes with HTTP 413 (default 5 MiB).
# MAX_REQUEST_BODY_BYTES=5242880
# Per-client-IP rate limit for ingestion endpoints.
# RATE_LIMIT_RPS=1000
# RATE_LIMIT_WINDOW_SECONDS=60

# Incident alerting (optional — unset = no alerts sent).
# Slack incoming-webhook URL: posts a message when an incident opens.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# PagerDuty Events API v2 routing key: triggers a PagerDuty incident.
# PAGERDUTY_ROUTING_KEY=

# For local testing without Docker infrastructure, use SQLite and disable Kafka:
# DATABASE_URL=sqlite:///./signforge.db
# KAFKA_BROKERS=  # leave empty or unset to disable Kafka and use sync processing

# For in-memory SQLite (tests only):
# DATABASE_URL=sqlite:///:memory:
